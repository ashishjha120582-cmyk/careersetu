# CareerSetu local environment
# Copy this file to .env and paste secrets only in .env.

PORT=5173
HOST=127.0.0.1

# Required for AI profile extraction, semantic embeddings, skill guides, and voice transcription.
OPENROUTER_API_KEY=

# Defaults used by the prototype. Change only when we intentionally test another model.
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_GUIDE_MODEL=openai/gpt-4o
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe
